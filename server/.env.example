# Copia este archivo a ".env" y coloca tu API key real. NUNCA subas el ".env" a git.
GEMINI_API_KEY=tu_api_key_de_google_ai_studio_aqui

# Modelo de Gemini a usar. Google cambia/retira modelos con frecuencia.
# A agosto de 2026: gemini-2.5-flash se retira el 16-oct-2026.
# Antes de desplegar en producción, revisa el listado vigente en:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash

# Puerto donde corre este servidor
PORT=3001

# Dominio(s) desde donde se le permite llamar a este backend (tu frontend).
# En desarrollo local con Live Server / file:// puedes dejar "*",
# pero en producción restringe esto a tu dominio real.
ALLOWED_ORIGIN=*
